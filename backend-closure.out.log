        SELECT 
          c.id AS "chunkId",
          c."documentId",
          c."documentVersion",
          d.title AS "title",
          c.content AS "content",
          c.source AS "source",
          c.language AS "language",
          c.domain AS "domain",
          c.category AS "category",
          c.metadata AS "metadata",
          CASE WHEN c.language = $4 THEN 0 ELSE 1 END AS "languagePreference",
          (e.embedding <=> $1::vector) AS "cosineDistance"
        FROM knowledge_embeddings e
        JOIN knowledge_chunks c ON e."chunkId" = c.id
        JOIN knowledge_documents d ON c."documentId" = d.id
        WHERE d.status IN ('ACTIVE', 'PUBLISHED')
          AND c."tenantId" = $2
          AND c.domain = $3
        ORDER BY "languagePreference" ASC, "cosineDistance" ASC
        LIMIT $5;
