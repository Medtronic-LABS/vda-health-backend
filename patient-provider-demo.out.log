query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"डायबिटीज को नियंत्रित रखने के लिए सही खान-पान बहुत जरूरी है। आपको अपने भोजन में कार्बोहाइड्रेट की मात्रा कम करनी चाहिए और फाइबर से भरपूर चीजें शामिल करनी चाहिए।\",\"sections\":[{\"title\":\"क्या खाएं (फायदेमंद चीजें)\",\"bullets\":[\"हरी पत्तेदार सब्जियां जैसे पालक, मेथी, बथुआ और लौकी, तोरई का सेवन अधिक करें।\",\"साबुत अनाज जैसे चोकरयुक्त आटा, ओट्स, बाजरा और रागी की रोटी खाएं।\",\"दालें, अंकुरित अनाज (स्प्राउट्स) और पनीर जैसे प्रोटीन युक्त आहार लें।\"]},{\"title\":\"किन चीजों से परहेज करें\",\"bullets\":[\"चीनी, गुड़, शहद, मिठाई और कोल्ड ड्रिंक्स से पूरी तरह दूरी बनाएं।\",\"आलू, शकरकंद, मैदा, सफेद चावल और जंक फूड का सेवन न करें।\",\"ज्यादा मीठे फल जैसे आम, केला, चीकू और अंगूर बहुत कम मात्रा में लें।\"]},{\"title\":\"जरूरी आदतें\",\"bullets\":[\"एक बार में ज्यादा खाने के बजाय दिन में 4-5 बार छोटे-छोटे हिस्सों में खाएं।\",\"रोजाना कम से कम 30 मिनट पैदल चलें या व्यायाम करें।\"]}],\"actions\":[{\"label\":\"डॉक्टर से सलाह लें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"डायबिटीज को नियंत्रित रखने के लिए सही खान-पान बहुत जरूरी है। आपको अपने भोजन में कार्बोहाइड्रेट की मात्रा कम करनी चाहिए और फाइबर से भरपूर चीजें शामिल करनी चाहिए।\\n\\nक्या खाएं (फायदेमंद चीजें)\\n• हरी पत्तेदार सब्जियां जैसे पालक, मेथी, बथुआ और लौकी, तोरई का सेवन अधिक करें।\\n• साबुत अनाज जैसे चोकरयुक्त आटा, ओट्स, बाजरा और रागी की रोटी खाएं।\\n• दालें, अंकुरित अनाज (स्प्राउट्स) और पनीर जैसे प्रोटीन युक्त आहार लें।\\n\\nकिन चीजों से परहेज करें\\n• चीनी, गुड़, शहद, मिठाई और कोल्ड ड्रिंक्स से पूरी तरह दूरी बनाएं।\\n• आलू, शकरकंद, मैदा, सफेद चावल और जंक फूड का सेवन न करें।\\n• ज्यादा मीठे फल जैसे आम, केला, चीकू और अंगूर बहुत कम मात्रा में लें।\\n\\nजरूरी आदतें\\n• एक बार में ज्यादा खाने के बजाय दिन में 4-5 बार छोटे-छोटे हिस्सों में खाएं।\\n• रोजाना कम से कम 30 मिनट पैदल चलें या व्यायाम करें।\",\"hi\":\"डायबिटीज को नियंत्रित रखने के लिए सही खान-पान बहुत जरूरी है। आपको अपने भोजन में कार्बोहाइड्रेट की मात्रा कम करनी चाहिए और फाइबर से भरपूर चीजें शामिल करनी चाहिए।\\n\\nक्या खाएं (फायदेमंद चीजें)\\n• हरी पत्तेदार सब्जियां जैसे पालक, मेथी, बथुआ और लौकी, तोरई का सेवन अधिक करें।\\n• साबुत अनाज जैसे चोकरयुक्त आटा, ओट्स, बाजरा और रागी की रोटी खाएं।\\n• दालें, अंकुरित अनाज (स्प्राउट्स) और पनीर जैसे प्रोटीन युक्त आहार लें।\\n\\nकिन चीजों से परहेज करें\\n• चीनी, गुड़, शहद, मिठाई और कोल्ड ड्रिंक्स से पूरी तरह दूरी बनाएं।\\n• आलू, शकरकंद, मैदा, सफेद चावल और जंक फूड का सेवन न करें।\\n• ज्यादा मीठे फल जैसे आम, केला, चीकू और अंगूर बहुत कम मात्रा में लें।\\n\\nजरूरी आदतें\\n• एक बार में ज्यादा खाने के बजाय दिन में 4-5 बार छोटे-छोटे हिस्सों में खाएं।\\n• रोजाना कम से कम 30 मिनट पैदल चलें या व्यायाम करें।\",\"en\":\"डायबिटीज को नियंत्रित रखने के लिए सही खान-पान बहुत जरूरी है। आपको अपने भोजन में कार्बोहाइड्रेट की मात्रा कम करनी चाहिए और फाइबर से भरपूर चीजें शामिल करनी चाहिए।\\n\\nक्या खाएं (फायदेमंद चीजें)\\n• हरी पत्तेदार सब्जियां जैसे पालक, मेथी, बथुआ और लौकी, तोरई का सेवन अधिक करें।\\n• साबुत अनाज जैसे चोकरयुक्त आटा, ओट्स, बाजरा और रागी की रोटी खाएं।\\n• दालें, अंकुरित अनाज (स्प्राउट्स) और पनीर जैसे प्रोटीन युक्त आहार लें।\\n\\nकिन चीजों से परहेज करें\\n• चीनी, गुड़, शहद, मिठाई और कोल्ड ड्रिंक्स से पूरी तरह दूरी बनाएं।\\n• आलू, शकरकंद, मैदा, सफेद चावल और जंक फूड का सेवन न करें।\\n• ज्यादा मीठे फल जैसे आम, केला, चीकू और अंगूर बहुत कम मात्रा में लें।\\n\\nजरूरी आदतें\\n• एक बार में ज्यादा खाने के बजाय दिन में 4-5 बार छोटे-छोटे हिस्सों में खाएं।\\n• रोजाना कम से कम 30 मिनट पैदल चलें या व्यायाम करें।\"}","GENERAL_HEALTH_QUERY","general-health-agent",7931,"COMPLETED","35d476bd-f1fc-4593-9280-73375b15a8a2"]
