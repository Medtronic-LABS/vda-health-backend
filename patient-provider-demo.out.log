query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"मधुमेह (Diabetes) को नियंत्रित रखने के लिए आप अपनी दवाइयां समय पर लें और जीवनशैली में कुछ जरूरी बदलाव करें।\",\"sections\":[{\"title\":\"महत्वपूर्ण कदम\",\"bullets\":[\"दवाइयां समय पर लें: डॉक्टर के निर्देशानुसार Metformin, Glimepiride और Telmisartan नियमित रूप से लें।\",\"संतुलित आहार: खाने में मीठा, मैदा और ज्यादा कार्बोहाइड्रेट कम करें। हरी सब्जियां, फाइबर और साबुत अनाज शामिल करें।\",\"नियमित व्यायाम: रोजाना कम से कम 30 मिनट पैदल चलें या हल्का व्यायाम करें।\",\"शुगर की जांच: अपने ब्लड शुगर के स्तर की नियमित रूप से जांच करें और उसे रिकॉर्ड करें।\"]},{\"title\":\"जरूरी सलाह\",\"bullets\":[\"किडनी की सुरक्षा के लिए अपने डॉक्टर की सलाह पर नियमित रूप से किडनी फंक्शन टेस्ट (KFT) और यूरिन टेस्ट करवाएं।\"]}],\"actions\":[{\"label\":\"डॉक्टर से परामर्श करें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"मधुमेह (Diabetes) को नियंत्रित रखने के लिए आप अपनी दवाइयां समय पर लें और जीवनशैली में कुछ जरूरी बदलाव करें।\\n\\nमहत्वपूर्ण कदम\\n• दवाइयां समय पर लें: डॉक्टर के निर्देशानुसार Metformin, Glimepiride और Telmisartan नियमित रूप से लें।\\n• संतुलित आहार: खाने में मीठा, मैदा और ज्यादा कार्बोहाइड्रेट कम करें। हरी सब्जियां, फाइबर और साबुत अनाज शामिल करें।\\n• नियमित व्यायाम: रोजाना कम से कम 30 मिनट पैदल चलें या हल्का व्यायाम करें।\\n• शुगर की जांच: अपने ब्लड शुगर के स्तर की नियमित रूप से जांच करें और उसे रिकॉर्ड करें।\\n\\nजरूरी सलाह\\n• किडनी की सुरक्षा के लिए अपने डॉक्टर की सलाह पर नियमित रूप से किडनी फंक्शन टेस्ट (KFT) और यूरिन टेस्ट करवाएं।\",\"hi\":\"मधुमेह (Diabetes) को नियंत्रित रखने के लिए आप अपनी दवाइयां समय पर लें और जीवनशैली में कुछ जरूरी बदलाव करें।\\n\\nमहत्वपूर्ण कदम\\n• दवाइयां समय पर लें: डॉक्टर के निर्देशानुसार Metformin, Glimepiride और Telmisartan नियमित रूप से लें।\\n• संतुलित आहार: खाने में मीठा, मैदा और ज्यादा कार्बोहाइड्रेट कम करें। हरी सब्जियां, फाइबर और साबुत अनाज शामिल करें।\\n• नियमित व्यायाम: रोजाना कम से कम 30 मिनट पैदल चलें या हल्का व्यायाम करें।\\n• शुगर की जांच: अपने ब्लड शुगर के स्तर की नियमित रूप से जांच करें और उसे रिकॉर्ड करें।\\n\\nजरूरी सलाह\\n• किडनी की सुरक्षा के लिए अपने डॉक्टर की सलाह पर नियमित रूप से किडनी फंक्शन टेस्ट (KFT) और यूरिन टेस्ट करवाएं।\",\"en\":\"मधुमेह (Diabetes) को नियंत्रित रखने के लिए आप अपनी दवाइयां समय पर लें और जीवनशैली में कुछ जरूरी बदलाव करें।\\n\\nमहत्वपूर्ण कदम\\n• दवाइयां समय पर लें: डॉक्टर के निर्देशानुसार Metformin, Glimepiride और Telmisartan नियमित रूप से लें।\\n• संतुलित आहार: खाने में मीठा, मैदा और ज्यादा कार्बोहाइड्रेट कम करें। हरी सब्जियां, फाइबर और साबुत अनाज शामिल करें।\\n• नियमित व्यायाम: रोजाना कम से कम 30 मिनट पैदल चलें या हल्का व्यायाम करें।\\n• शुगर की जांच: अपने ब्लड शुगर के स्तर की नियमित रूप से जांच करें और उसे रिकॉर्ड करें।\\n\\nजरूरी सलाह\\n• किडनी की सुरक्षा के लिए अपने डॉक्टर की सलाह पर नियमित रूप से किडनी फंक्शन टेस्ट (KFT) और यूरिन टेस्ट करवाएं।\"}","GENERAL_HEALTH_QUERY","general-health-agent",28019,"COMPLETED","0aef95c0-1add-4126-8e7c-3eb0184f0055"]
