query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपका ब्लड शुगर और HbA1c स्तर काफी बढ़ा हुआ है। कृपया तुरंत अपने डॉक्टर से संपर्क करें।\",\"sections\":[{\"title\":\"आपके शुगर जांच के परिणाम\",\"bullets\":[\"Fasting blood glucose (खाली पेट): 302 mg/dL (High - बहुत अधिक)\",\"Postprandial blood glucose (खाने के बाद): 372 mg/dL\",\"Hemoglobin A1c (HbA1c): 10.1 % (High - बहुत अधिक)\"]},{\"title\":\"HbA1c का क्या मतलब है?\",\"body\":\"HbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका 10.1% का स्तर यह दर्शाता है कि पिछले कुछ महीनों में आपका शुगर नियंत्रण में नहीं रहा है।\"}],\"cards\":[{\"title\":\"Fasting blood glucose\",\"value\":\"302 mg/dL\",\"subtitle\":\"High\"},{\"title\":\"Postprandial blood glucose\",\"value\":\"372 mg/dL\",\"subtitle\":\"Normal\"}],\"actions\":[{\"label\":\"डॉक्टर से परामर्श करें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपका ब्लड शुगर और HbA1c स्तर काफी बढ़ा हुआ है। कृपया तुरंत अपने डॉक्टर से संपर्क करें।\\n\\nआपके शुगर जांच के परिणाम\\n• Fasting blood glucose (खाली पेट): 302 mg/dL (High - बहुत अधिक)\\n• Postprandial blood glucose (खाने के बाद): 372 mg/dL\\n• Hemoglobin A1c (HbA1c): 10.1 % (High - बहुत अधिक)\\n\\nHbA1c का क्या मतलब है?\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका 10.1% का स्तर यह दर्शाता है कि पिछले कुछ महीनों में आपका शुगर नियंत्रण में नहीं रहा है।\\n\\nFasting blood glucose: 302 mg/dL: High\\n\\nPostprandial blood glucose: 372 mg/dL: Normal\",\"hi\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपका ब्लड शुगर और HbA1c स्तर काफी बढ़ा हुआ है। कृपया तुरंत अपने डॉक्टर से संपर्क करें।\\n\\nआपके शुगर जांच के परिणाम\\n• Fasting blood glucose (खाली पेट): 302 mg/dL (High - बहुत अधिक)\\n• Postprandial blood glucose (खाने के बाद): 372 mg/dL\\n• Hemoglobin A1c (HbA1c): 10.1 % (High - बहुत अधिक)\\n\\nHbA1c का क्या मतलब है?\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका 10.1% का स्तर यह दर्शाता है कि पिछले कुछ महीनों में आपका शुगर नियंत्रण में नहीं रहा है।\\n\\nFasting blood glucose: 302 mg/dL: High\\n\\nPostprandial blood glucose: 372 mg/dL: Normal\",\"en\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपका ब्लड शुगर और HbA1c स्तर काफी बढ़ा हुआ है। कृपया तुरंत अपने डॉक्टर से संपर्क करें।\\n\\nआपके शुगर जांच के परिणाम\\n• Fasting blood glucose (खाली पेट): 302 mg/dL (High - बहुत अधिक)\\n• Postprandial blood glucose (खाने के बाद): 372 mg/dL\\n• Hemoglobin A1c (HbA1c): 10.1 % (High - बहुत अधिक)\\n\\nHbA1c का क्या मतलब है?\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका 10.1% का स्तर यह दर्शाता है कि पिछले कुछ महीनों में आपका शुगर नियंत्रण में नहीं रहा है।\\n\\nFasting blood glucose: 302 mg/dL: High\\n\\nPostprandial blood glucose: 372 mg/dL: Normal\",\"lab_results\":[{\"test_name\":\"Fasting blood glucose\",\"value\":\"302\",\"unit\":\"mg/dL\",\"reference_range\":null,\"observation_date\":null,\"interpretation\":\"High\"},{\"test_name\":\"Postprandial blood glucose\",\"value\":\"372\",\"unit\":\"mg/dL\",\"reference_range\":null,\"observation_date\":null,\"interpretation\":\"Normal\"}]}","LAB_RESULT_QUERY","lab-report-agent",8217,"COMPLETED","2347fb24-560a-4271-9ab5-8752bae678c8"]
