query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपको 'Diabetes mellitus with renal complication' (किडनी की जटिलता के साथ मधुमेह) की सक्रिय समस्या है।\",\"sections\":[{\"title\":\"आपकी स्थिति\",\"body\":\"आपके रिकॉर्ड में दर्ज है कि आपको मधुमेह के साथ किडनी से जुड़ी जटिलता (renal complication) है। बिना किसी लक्षण के भी यह बीमारी धीरे-धीरे बढ़ सकती है, इसलिए इसे नियंत्रित रखना बहुत जरूरी है।\"},{\"title\":\"महत्वपूर्ण सलाह\",\"bullets\":[\"अपनी निर्धारित दवाइयां नियमित रूप से लें और डॉक्टर के संपर्क में रहें।\",\"किडनी की कार्यप्रणाली की निगरानी के लिए समय-समय पर आवश्यक लैब टेस्ट (जैसे यूरिन और किडनी फंक्शन टेस्ट) करवाएं।\",\"ब्लड शुगर और ब्लड प्रेशर को नियंत्रित रखने के लिए संतुलित आहार लें और नियमित व्यायाम करें।\"]}],\"actions\":[{\"label\":\"डॉक्टर से परामर्श करें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपको 'Diabetes mellitus with renal complication' (किडनी की जटिलता के साथ मधुमेह) की सक्रिय समस्या है।\\n\\nआपकी स्थिति\\nआपके रिकॉर्ड में दर्ज है कि आपको मधुमेह के साथ किडनी से जुड़ी जटिलता (renal complication) है। बिना किसी लक्षण के भी यह बीमारी धीरे-धीरे बढ़ सकती है, इसलिए इसे नियंत्रित रखना बहुत जरूरी है।\\n\\nमहत्वपूर्ण सलाह\\n• अपनी निर्धारित दवाइयां नियमित रूप से लें और डॉक्टर के संपर्क में रहें।\\n• किडनी की कार्यप्रणाली की निगरानी के लिए समय-समय पर आवश्यक लैब टेस्ट (जैसे यूरिन और किडनी फंक्शन टेस्ट) करवाएं।\\n• ब्लड शुगर और ब्लड प्रेशर को नियंत्रित रखने के लिए संतुलित आहार लें और नियमित व्यायाम करें।\",\"hi\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपको 'Diabetes mellitus with renal complication' (किडनी की जटिलता के साथ मधुमेह) की सक्रिय समस्या है।\\n\\nआपकी स्थिति\\nआपके रिकॉर्ड में दर्ज है कि आपको मधुमेह के साथ किडनी से जुड़ी जटिलता (renal complication) है। बिना किसी लक्षण के भी यह बीमारी धीरे-धीरे बढ़ सकती है, इसलिए इसे नियंत्रित रखना बहुत जरूरी है।\\n\\nमहत्वपूर्ण सलाह\\n• अपनी निर्धारित दवाइयां नियमित रूप से लें और डॉक्टर के संपर्क में रहें।\\n• किडनी की कार्यप्रणाली की निगरानी के लिए समय-समय पर आवश्यक लैब टेस्ट (जैसे यूरिन और किडनी फंक्शन टेस्ट) करवाएं।\\n• ब्लड शुगर और ब्लड प्रेशर को नियंत्रित रखने के लिए संतुलित आहार लें और नियमित व्यायाम करें।\",\"en\":\"आपके स्वास्थ्य रिकॉर्ड के अनुसार, आपको 'Diabetes mellitus with renal complication' (किडनी की जटिलता के साथ मधुमेह) की सक्रिय समस्या है।\\n\\nआपकी स्थिति\\nआपके रिकॉर्ड में दर्ज है कि आपको मधुमेह के साथ किडनी से जुड़ी जटिलता (renal complication) है। बिना किसी लक्षण के भी यह बीमारी धीरे-धीरे बढ़ सकती है, इसलिए इसे नियंत्रित रखना बहुत जरूरी है।\\n\\nमहत्वपूर्ण सलाह\\n• अपनी निर्धारित दवाइयां नियमित रूप से लें और डॉक्टर के संपर्क में रहें।\\n• किडनी की कार्यप्रणाली की निगरानी के लिए समय-समय पर आवश्यक लैब टेस्ट (जैसे यूरिन और किडनी फंक्शन टेस्ट) करवाएं।\\n• ब्लड शुगर और ब्लड प्रेशर को नियंत्रित रखने के लिए संतुलित आहार लें और नियमित व्यायाम करें।\",\"diagnoses\":[{\"condition_name\":\"Diabetes mellitus with renal complication\",\"severity\":null,\"onset_date\":null,\"status\":\"active\"}]}","DIAGNOSIS_QUERY","diagnosis-agent",10262,"COMPLETED","d92e2dd7-0604-436f-845b-5a10c1ff7fd5"]
