query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"आमतौर पर मधुमेह या सामान्य स्वास्थ्य के लिए रोजाना 30 मिनट की तेज सैर (brisk walk) करने की सलाह दी जाती है। हालांकि, आपके उपलब्ध स्वास्थ्य रिकॉर्ड में कोई विशिष्ट केयर प्लान नहीं मिला है।\",\"sections\":[{\"title\":\"सैर करने के सामान्य नियम\",\"bullets\":[\"रोजाना कम से कम 30 मिनट की तेज सैर (brisk walk) करें।\",\"सैर करने से पहले और बाद में पानी पीकर खुद को हाइड्रेटेड रखें।\",\"पैरों की सुरक्षा के लिए आरामदायक और सही फिटिंग वाले जूते पहनें।\"]},{\"title\":\"सुरक्षा के लिए जरूरी बातें\",\"bullets\":[\"यदि आपको शुगर की बीमारी है, तो सैर से पहले और बाद में ब्लड शुगर की जांच करें।\",\"शुगर अचानक कम होने की स्थिति के लिए हमेशा अपने पास ग्लूकोज टैबलेट या फलों का जूस रखें।\"]}],\"actions\":[{\"label\":\"डॉक्टर से सलाह लें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"आमतौर पर मधुमेह या सामान्य स्वास्थ्य के लिए रोजाना 30 मिनट की तेज सैर (brisk walk) करने की सलाह दी जाती है। हालांकि, आपके उपलब्ध स्वास्थ्य रिकॉर्ड में कोई विशिष्ट केयर प्लान नहीं मिला है।\\n\\nसैर करने के सामान्य नियम\\n• रोजाना कम से कम 30 मिनट की तेज सैर (brisk walk) करें।\\n• सैर करने से पहले और बाद में पानी पीकर खुद को हाइड्रेटेड रखें।\\n• पैरों की सुरक्षा के लिए आरामदायक और सही फिटिंग वाले जूते पहनें।\\n\\nसुरक्षा के लिए जरूरी बातें\\n• यदि आपको शुगर की बीमारी है, तो सैर से पहले और बाद में ब्लड शुगर की जांच करें।\\n• शुगर अचानक कम होने की स्थिति के लिए हमेशा अपने पास ग्लूकोज टैबलेट या फलों का जूस रखें।\",\"hi\":\"आमतौर पर मधुमेह या सामान्य स्वास्थ्य के लिए रोजाना 30 मिनट की तेज सैर (brisk walk) करने की सलाह दी जाती है। हालांकि, आपके उपलब्ध स्वास्थ्य रिकॉर्ड में कोई विशिष्ट केयर प्लान नहीं मिला है।\\n\\nसैर करने के सामान्य नियम\\n• रोजाना कम से कम 30 मिनट की तेज सैर (brisk walk) करें।\\n• सैर करने से पहले और बाद में पानी पीकर खुद को हाइड्रेटेड रखें।\\n• पैरों की सुरक्षा के लिए आरामदायक और सही फिटिंग वाले जूते पहनें।\\n\\nसुरक्षा के लिए जरूरी बातें\\n• यदि आपको शुगर की बीमारी है, तो सैर से पहले और बाद में ब्लड शुगर की जांच करें।\\n• शुगर अचानक कम होने की स्थिति के लिए हमेशा अपने पास ग्लूकोज टैबलेट या फलों का जूस रखें।\",\"en\":\"आमतौर पर मधुमेह या सामान्य स्वास्थ्य के लिए रोजाना 30 मिनट की तेज सैर (brisk walk) करने की सलाह दी जाती है। हालांकि, आपके उपलब्ध स्वास्थ्य रिकॉर्ड में कोई विशिष्ट केयर प्लान नहीं मिला है।\\n\\nसैर करने के सामान्य नियम\\n• रोजाना कम से कम 30 मिनट की तेज सैर (brisk walk) करें।\\n• सैर करने से पहले और बाद में पानी पीकर खुद को हाइड्रेटेड रखें।\\n• पैरों की सुरक्षा के लिए आरामदायक और सही फिटिंग वाले जूते पहनें।\\n\\nसुरक्षा के लिए जरूरी बातें\\n• यदि आपको शुगर की बीमारी है, तो सैर से पहले और बाद में ब्लड शुगर की जांच करें।\\n• शुगर अचानक कम होने की स्थिति के लिए हमेशा अपने पास ग्लूकोज टैबलेट या फलों का जूस रखें।\"}","GENERAL_HEALTH_QUERY","general-health-agent",9211,"COMPLETED","c19a6577-24e1-488e-8827-c189d286eb78"]
