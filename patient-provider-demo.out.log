query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"आपके रिकॉर्ड के अनुसार, डायबिटीज (शुगर) के लिए आपकी दो सक्रिय दवाइयां हैं: Metformin 850mg और Glimepiride 1mg।\",\"sections\":[{\"title\":\"डायबिटीज की दवाइयां\",\"bullets\":[\"Metformin 850mg tablet: 1 गोली दिन में दो बार, खाना खाने के बाद लें।\",\"Glimepiride 1mg tablet: 1 गोली दिन में एक बार, नाश्ते से पहले लें।\"]},{\"title\":\"अन्य सक्रिय दवा\",\"bullets\":[\"Telmisartan 80mg tablet: यह ब्लड प्रेशर के लिए है, जिसे सुबह एक बार लेना होता है।\"]}],\"cards\":[{\"title\":\"Metformin 850mg tablet\",\"value\":\"1 tablet twice daily after meals\",\"subtitle\":\"1 tablet twice daily after meals · Oral\"},{\"title\":\"Telmisartan 80mg tablet\",\"value\":\"1 tablet once daily in the morning\",\"subtitle\":\"1 tablet once daily in the morning · Oral\"},{\"title\":\"Glimepiride 1mg tablet\",\"value\":\"1 tablet once daily before breakfast\",\"subtitle\":\"1 tablet once daily before breakfast · Oral\"}],\"actions\":[{\"label\":\"डॉक्टर से सलाह लें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"आपके रिकॉर्ड के अनुसार, डायबिटीज (शुगर) के लिए आपकी दो सक्रिय दवाइयां हैं: Metformin 850mg और Glimepiride 1mg।\\n\\nडायबिटीज की दवाइयां\\n• Metformin 850mg tablet: 1 गोली दिन में दो बार, खाना खाने के बाद लें।\\n• Glimepiride 1mg tablet: 1 गोली दिन में एक बार, नाश्ते से पहले लें।\\n\\nअन्य सक्रिय दवा\\n• Telmisartan 80mg tablet: यह ब्लड प्रेशर के लिए है, जिसे सुबह एक बार लेना होता है।\\n\\nMetformin 850mg tablet: 1 tablet twice daily after meals: 1 tablet twice daily after meals · Oral\\n\\nTelmisartan 80mg tablet: 1 tablet once daily in the morning: 1 tablet once daily in the morning · Oral\\n\\nGlimepiride 1mg tablet: 1 tablet once daily before breakfast: 1 tablet once daily before breakfast · Oral\",\"hi\":\"आपके रिकॉर्ड के अनुसार, डायबिटीज (शुगर) के लिए आपकी दो सक्रिय दवाइयां हैं: Metformin 850mg और Glimepiride 1mg।\\n\\nडायबिटीज की दवाइयां\\n• Metformin 850mg tablet: 1 गोली दिन में दो बार, खाना खाने के बाद लें।\\n• Glimepiride 1mg tablet: 1 गोली दिन में एक बार, नाश्ते से पहले लें।\\n\\nअन्य सक्रिय दवा\\n• Telmisartan 80mg tablet: यह ब्लड प्रेशर के लिए है, जिसे सुबह एक बार लेना होता है।\\n\\nMetformin 850mg tablet: 1 tablet twice daily after meals: 1 tablet twice daily after meals · Oral\\n\\nTelmisartan 80mg tablet: 1 tablet once daily in the morning: 1 tablet once daily in the morning · Oral\\n\\nGlimepiride 1mg tablet: 1 tablet once daily before breakfast: 1 tablet once daily before breakfast · Oral\",\"en\":\"आपके रिकॉर्ड के अनुसार, डायबिटीज (शुगर) के लिए आपकी दो सक्रिय दवाइयां हैं: Metformin 850mg और Glimepiride 1mg।\\n\\nडायबिटीज की दवाइयां\\n• Metformin 850mg tablet: 1 गोली दिन में दो बार, खाना खाने के बाद लें।\\n• Glimepiride 1mg tablet: 1 गोली दिन में एक बार, नाश्ते से पहले लें।\\n\\nअन्य सक्रिय दवा\\n• Telmisartan 80mg tablet: यह ब्लड प्रेशर के लिए है, जिसे सुबह एक बार लेना होता है।\\n\\nMetformin 850mg tablet: 1 tablet twice daily after meals: 1 tablet twice daily after meals · Oral\\n\\nTelmisartan 80mg tablet: 1 tablet once daily in the morning: 1 tablet once daily in the morning · Oral\\n\\nGlimepiride 1mg tablet: 1 tablet once daily before breakfast: 1 tablet once daily before breakfast · Oral\",\"medications\":[{\"name\":\"Metformin 850mg tablet\",\"dosage\":\"1 tablet twice daily after meals\",\"frequency\":\"1 tablet twice daily after meals\",\"status\":\"active\"},{\"name\":\"Telmisartan 80mg tablet\",\"dosage\":\"1 tablet once daily in the morning\",\"frequency\":\"1 tablet once daily in the morning\",\"status\":\"active\"},{\"name\":\"Glimepiride 1mg tablet\",\"dosage\":\"1 tablet once daily before breakfast\",\"frequency\":\"1 tablet once daily before breakfast\",\"status\":\"active\"}]}","MEDICATION_QUERY","medication-agent",7313,"COMPLETED","c21e2ab3-acac-4e23-b450-efaaf71d398e"]
