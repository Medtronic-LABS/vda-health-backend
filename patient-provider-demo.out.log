query: UPDATE "conversation_turns" SET "outputText" = $1, "intent" = $2, "selectedAgent" = $3, "latency" = $4, "status" = $5 WHERE "id" = $6 -- PARAMETERS: ["{\"summary\":\"आपके रिकॉर्ड के अनुसार, आपकी HbA1c रिपोर्ट 10.1% है, जो कि सामान्य से अधिक (High) है।\",\"sections\":[{\"title\":\"HbA1c रिपोर्ट की जानकारी\",\"body\":\"HbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका परिणाम 10.1% है, जो काफी बढ़ा हुआ है।\",\"bullets\":[\"HbA1c: 10.1% (High)\",\"Fasting blood glucose: 302 mg/dL (High)\",\"Postprandial blood glucose: 372 mg/dL\"]},{\"title\":\"महत्वपूर्ण सलाह\",\"body\":\"कृपया अपने इस बढ़े हुए शुगर स्तर और उपचार के बदलाव के लिए तुरंत अपने डॉक्टर से संपर्क करें।\"}],\"cards\":[],\"actions\":[{\"label\":\"डॉक्टर से परामर्श करें\",\"action\":\"CONSULT_DOCTOR\"}],\"patient_text\":\"आपके रिकॉर्ड के अनुसार, आपकी HbA1c रिपोर्ट 10.1% है, जो कि सामान्य से अधिक (High) है।\\n\\nHbA1c रिपोर्ट की जानकारी\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका परिणाम 10.1% है, जो काफी बढ़ा हुआ है।\\n• HbA1c: 10.1% (High)\\n• Fasting blood glucose: 302 mg/dL (High)\\n• Postprandial blood glucose: 372 mg/dL\\n\\nमहत्वपूर्ण सलाह\\nकृपया अपने इस बढ़े हुए शुगर स्तर और उपचार के बदलाव के लिए तुरंत अपने डॉक्टर से संपर्क करें।\",\"hi\":\"आपके रिकॉर्ड के अनुसार, आपकी HbA1c रिपोर्ट 10.1% है, जो कि सामान्य से अधिक (High) है।\\n\\nHbA1c रिपोर्ट की जानकारी\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका परिणाम 10.1% है, जो काफी बढ़ा हुआ है।\\n• HbA1c: 10.1% (High)\\n• Fasting blood glucose: 302 mg/dL (High)\\n• Postprandial blood glucose: 372 mg/dL\\n\\nमहत्वपूर्ण सलाह\\nकृपया अपने इस बढ़े हुए शुगर स्तर और उपचार के बदलाव के लिए तुरंत अपने डॉक्टर से संपर्क करें।\",\"en\":\"आपके रिकॉर्ड के अनुसार, आपकी HbA1c रिपोर्ट 10.1% है, जो कि सामान्य से अधिक (High) है।\\n\\nHbA1c रिपोर्ट की जानकारी\\nHbA1c रक्त जांच पिछले लगभग दो से तीन महीनों के औसत रक्त शर्करा स्तर का संकेत देती है। आपका परिणाम 10.1% है, जो काफी बढ़ा हुआ है।\\n• HbA1c: 10.1% (High)\\n• Fasting blood glucose: 302 mg/dL (High)\\n• Postprandial blood glucose: 372 mg/dL\\n\\nमहत्वपूर्ण सलाह\\nकृपया अपने इस बढ़े हुए शुगर स्तर और उपचार के बदलाव के लिए तुरंत अपने डॉक्टर से संपर्क करें।\",\"lab_results\":[]}","LAB_RESULT_QUERY","lab-report-agent",5703,"COMPLETED","aadbbb0d-7a46-4193-9efd-1f5edab38484"]
