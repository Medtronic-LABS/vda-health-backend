# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=vda_health

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ABDM / Health Record Provider Configuration
ABDM_ENABLED=false
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIU_ID=
ABDM_X_CM_ID=sbx
ABDM_CALLBACK_URL=http://localhost:3000
ABDM_TIMEOUT_MS=10000
ABDM_MAX_RETRIES=2

# AI Provider Credentials - Sarvam AI
SARVAM_ENABLED=false
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=mayura:v1
SARVAM_LLM_MODEL=sarvam-llm-v1
SARVAM_TRANSLATION_MODEL=mayura:v1
SARVAM_SAARAS_STT_MODEL=sarvam-saaras-stt-v1
SARVAM_BULBUL_TTS_MODEL=sarvam-bulbul-tts-v1
SARVAM_TIMEOUT_MS=10000
SARVAM_MAX_RETRIES=2

# Voice routing. HF_TOKEN is read only by services/sravaani-stt/.env and must
# never be copied into Android, frontend bundles, or source control.
VOICE_STT_PROVIDER=sravaani
VOICE_STT_FALLBACK_PROVIDER=sarvam
VOICE_STT_FALLBACK_ENABLED=true
SRAVAANI_BASE_URL=http://127.0.0.1:8001
VOICE_STT_TIMEOUT_MS=20000
VOICE_TTS_PROVIDER=dhvaani
VOICE_TTS_FALLBACK_PROVIDER=sarvam
VOICE_TTS_FALLBACK_ENABLED=true
DHVAANI_BASE_URL=http://127.0.0.1:8002
VOICE_TTS_TIMEOUT_MS=120000
# Configure these only in services/dhvaani-tts/.env. Do not commit the
# approved reference voice or its exact transcript.
DHVAANI_REFERENCE_WAV=
DHVAANI_REFERENCE_TEXT=

# AI Provider Credentials - Gemini
AI_PROVIDER_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_KEY_COOLDOWN_SECONDS=60
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_ID=gemini-3.5-flash
GEMINI_TIMEOUT_MS=10000
GEMINI_MAX_RETRIES=2

# AI Input/Output Boundaries
AI_MAX_INPUT_LENGTH=2000
AI_MAX_OUTPUT_LENGTH=2000

# Clinical Queue Configuration
# [DECISION_REQUIRED] Clinician lease duration pending confirmation
CLINICIAN_LEASE_TTL_SECONDS=300

# RAGAS Target Thresholds (Configurable)
RAGAS_THRESHOLD_FAITHFULNESS=0.90
RAGAS_THRESHOLD_ANSWER_RELEVANCY=0.85
RAGAS_THRESHOLD_CONTEXT_RECALL=0.85
RAGAS_THRESHOLD_CONTEXT_PRECISION=0.80
RAGAS_THRESHOLD_ESCALATION_RECALL=0.98

# Security & Correlation
X_CORRELATION_ID_HEADER=x-correlation-id

# Development-only authentication settings (MOCKS host JWT tokens verification)
DEV_AUTH_ENABLED=true
DEV_AUTH_PARTNER_ID=dev-partner
DEV_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
DEV_AUTH_EXTERNAL_ID=dev-host-user-123
DEV_AUTH_SUBJECT_ABHA_REF=dev-subject-abha-ref-123
DEV_AUTH_TOKEN=dev-token
DEV_AUTH_CONTEXT_COMPLETENESS=COMPLETE

# Audit security configurations (HMAC Key Rotation)
AUDIT_HMAC_KEY_ID=v1
AUDIT_HMAC_SECRET=dev-hmac-secret-key-123

# Idempotency wait time limits
IDEMPOTENCY_WAIT_TIMEOUT_MS=3000

# Public HTTP status code for session expiration (DECISION_REQUIRED final value)
SESSION_EXPIRED_HTTP_STATUS=410

# Phase 9 Operationalization & Telemetry Configuration
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_TENANT_MAX_REQUESTS=100
RATE_LIMIT_SESSION_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
HEALTH_CACHE_TTL_MS=2000
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_INTERVAL_MS=5000
AUDIT_EXPORT_BATCH_SIZE=50
AUDIT_EXPORT_MAX_RETRIES=3

# Phase 11 Knowledge RAG & Agent Platform Configuration
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_EMBEDDING_PROVIDER=local
KNOWLEDGE_EMBEDDING_MODEL=all-MiniLM-L6-v2
KNOWLEDGE_EMBEDDING_DIMENSION=384
KNOWLEDGE_MAX_RESULTS=5
KNOWLEDGE_MAX_CHUNK_LENGTH=1200
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.70
KNOWLEDGE_MAX_CONTEXT_LENGTH=5000
## Development-only local patient selector. Keep the dataset outside source control.
LOCAL_PATIENT_SUMMARY_PATH=
LOCAL_PATIENT_BUNDLES_PATH=

# LangSmith AI Observability (Cost, Latency & Call Necessity Tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=vda-health-backend
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
